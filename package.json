{
  "name": "hecate",
  "version": "1.0.0",
  "description": "Unified operator-grade red team platform",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "api/server.js",
  "bin": {
    "hecate": "cli/index.js"
  },
  "scripts": {
    "start": "node --experimental-sqlite cli/index.js start",
    "keygen": "node cli/index.js keygen",
    "check:encoding": "node scripts/check-encoding.js",
    "test": "node --experimental-sqlite --test core/core.test.js core/authorization.test.js core/phase3.test.js api/api.test.js api/browser-session.test.js api/websocket/ws-browser-session.test.js api/phase4.test.js api/authorization.test.js api/websocket/ws-policy.test.js modules/recon/recon.test.js modules/evil-proxy/evil-proxy.test.js modules/c2/c2.test.js modules/delivery/delivery.test.js modules/mitm/mitm.test.js modules/webapp/webapp.test.js modules/post-exploit/post-exploit.test.js",
    "test:core": "node --experimental-sqlite --test core/core.test.js",
    "test:api": "node --experimental-sqlite --test api/api.test.js api/browser-session.test.js api/websocket/ws-browser-session.test.js",
    "test:modules": "node --experimental-sqlite --test modules/*/recon.test.js modules/*/evil-proxy.test.js modules/*/c2.test.js modules/*/delivery.test.js modules/*/mitm.test.js modules/*/webapp.test.js modules/*/post-exploit.test.js",
    "test:recon": "node --test modules/recon/recon.test.js",
    "test:evil-proxy": "node --test modules/evil-proxy/evil-proxy.test.js",
    "test:c2": "node --test modules/c2/c2.test.js",
    "test:delivery": "node --test modules/delivery/delivery.test.js",
    "test:mitm": "node --test modules/mitm/mitm.test.js",
    "test:webapp": "node --test modules/webapp/webapp.test.js",
    "test:post-exploit": "node --test modules/post-exploit/post-exploit.test.js",
    "build:ui": "vite build --config ui/vite.config.js",
    "dev:ui": "vite --config ui/vite.config.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.21.0",
    "ws": "^8.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0"
  },
  "optionalDependencies": {
    "nodemailer": "^6.9.0"
  },
  "hecate": {
    "defaultPort": 7331,
    "defaultHost": "127.0.0.1",
    "nodeFlags": "--experimental-sqlite",
    "phases": 7,
    "modules": [
      "recon",
      "evil-proxy",
      "c2",
      "delivery",
      "mitm",
      "webapp",
      "post-exploit"
    ],
    "coreModules": [
      "db",
      "crypto",
      "store",
      "graph",
      "audit",
      "events"
    ]
  }
}
